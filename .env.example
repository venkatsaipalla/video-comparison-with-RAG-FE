# Copy to `.env` at the project root. Restart `npm run dev` after editing.

# Brain API URL reachable from the browser (local dev: http://localhost:8000)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-only — Next.js /api/brain/* proxy for history/init (not used for /chat)
BACKEND_API_URL=http://localhost:8000

# Server-only — must match brain BACKEND_API_KEY (used by /api/chat and /api/brain proxy)
BRAIN_API_KEY=change-me-to-match-backend

# Google OAuth (same client as backend GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET=

# Timeout for POST /init and POST /chat (seconds)
NEXT_PUBLIC_API_TIMEOUT_SEC=240
# Server-only — /api/chat and /api/brain proxy timeout (seconds). Use this for /api/chat.
BRAIN_PROXY_TIMEOUT_SEC=240
