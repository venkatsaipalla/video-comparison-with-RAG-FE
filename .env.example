# Copy to `.env` at the project root. Restart `npm run dev` after editing.

# Brain API (Render or local)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-only — must match brain BACKEND_API_KEY (not exposed to the browser)
BRAIN_API_KEY=change-me-to-match-backend

# Google OAuth (same client as backend GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET=

# Timeout for POST /init and POST /chat (seconds, max 120)
NEXT_PUBLIC_API_TIMEOUT_SEC=120
